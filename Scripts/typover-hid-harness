#!/bin/bash

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "$script_directory/.." && pwd)"
configuration="${TYPOVER_HID_HARNESS_CONFIGURATION:-release}"
binary="$repository_root/.build/$configuration/TypoverBearHIDHarness"

if [[ ! -x "$binary" ]]; then
  echo "TypoverBearHIDHarness is not built." >&2
  echo "Run: swift build --configuration $configuration --product TypoverBearHIDHarness" >&2
  exit 2
fi

if [[ "${1:-}" != "plan" && "${1:-}" != "snapshot" && -z "${KEYPATH_FIXTURE_TOKEN:-}" ]]; then
  secrets_file="${KEYPATH_FIXTURE_SECRETS_FILE:-$HOME/dotfiles/secrets.env}"
  if ! command -v sops >/dev/null 2>&1 || [[ ! -f "$secrets_file" ]]; then
    echo "Could not load KEYPATH_FIXTURE_TOKEN from encrypted secrets." >&2
    exit 2
  fi

  while IFS='=' read -r name value; do
    if [[ "$name" == "KEYPATH_FIXTURE_TOKEN" && -n "$value" ]]; then
      export KEYPATH_FIXTURE_TOKEN="$value"
      break
    fi
  done < <(sops -d "$secrets_file")
fi

if [[ "${1:-}" != "plan" && "${1:-}" != "snapshot" && -z "${KEYPATH_FIXTURE_TOKEN:-}" ]]; then
  echo "KEYPATH_FIXTURE_TOKEN is not configured." >&2
  exit 2
fi

exec "$binary" "$@"
